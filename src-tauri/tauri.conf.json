{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThumbDesk",
  "version": "2.3.0",
  "identifier": "com.thumbdesk.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ThumbDesk",
        "width": 1240,
        "height": 780,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
